FROM python:3.14-slim

# Install uv
RUN pip install --no-cache-dir uv

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project

COPY . .
RUN uv sync --frozen

EXPOSE 5000

ENTRYPOINT ["uv", "run"]
CMD ["/bin/sh", "-c", "flask db upgrade && flask run --host=0.0.0.0 --port=5000 --reload"]
